# Copy to .env.local and fill in from your Supabase project
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Project Settings → API → service_role (SECRET — server only, never exposed to the browser)
# Used by the one-time setup script and admin server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI API key (server only) for admin "Improve with AI" actions.
OPENAI_API_KEY=your-openai-api-key
